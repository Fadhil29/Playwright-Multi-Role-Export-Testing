# staging (default)
STAGING_APP_URL=https://app.staging.example.com
DASHBOARD_PATH=/dashboard
STAGING_SSO_LAUNCHER_URL=https://sso.staging.example.com/apps/launch?appId=xxxx
STAGING_USERNAME=
STAGING_PASSWORD=

# production (npm run auth:prod / npm run test:prod)
PROD_SSO_URL=https://sso.example.com
PROD_SSO_HOME_PATH=/home
PROD_APP_TILE_SELECTOR=[data-app="my-app"]
PROD_APP_URL=
PROD_USERNAME=
PROD_PASSWORD=
